# Copy this file to `.env` (same folder) and fill in real values. `.env` is git-ignored.
# The backend reads it automatically when started from the repo root or from backend/.

# ---- Server ----
SERVER_PORT=8081
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- MySQL (see docs/sql/01-create-database.sql) ----
DB_URL=jdbc:mysql://localhost:3306/linguavoice_db?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=linguavoice
DB_PASSWORD=

# ---- Voice uploads ----
MAX_AUDIO_UPLOAD_SIZE=10MB

# ---- Authentication (used from Phase 2) ----
# Generate with:  openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# ---- AI providers ----
# Until a provider and key are set, the matching feature reports "not configured" (HTTP 503).
# The app never returns fake results. Keys stay on the server and are never sent to the browser.

# Text translation (Phase 3): azure | google | none
#   azure : Azure portal → create a "Translator" resource → Keys and Endpoint → KEY 1 + Location/Region
#   google: Google Cloud console → enable "Cloud Translation API" → Credentials → API key
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
# Azure only: the resource's Location/Region (e.g. southafricanorth). Leave empty for a "Global" resource.
TRANSLATION_REGION=
# Optional: override the provider's public endpoint (normally leave empty)
TRANSLATION_ENDPOINT=

# Speech-to-text (Phase 4): azure | google | none
#   azure : Azure portal → create a "Speech" resource → Keys and Endpoint → KEY 1 + Location/Region
#           (an "Azure AI services" multi-service key also works for both translation and speech)
#   google: Google Cloud console → enable "Cloud Speech-to-Text API" → use an API key allowed for it
# Without it, the translator offers the browser's own speech recognition as a fallback (where supported).
# Voice language support differs by provider: Azure cannot recognise isiXhosa; Google can.
STT_PROVIDER=
STT_API_KEY=
# Azure only, required: the Speech resource's region (e.g. southafricanorth)
STT_REGION=
# Optional: override the provider's public endpoint (normally leave empty)
STT_ENDPOINT=

# Text-to-speech (Phase 5)
TTS_PROVIDER=
TTS_API_KEY=

# Maximum AI requests (translate, speech) per user per minute. Exceeding it returns HTTP 429.
AI_RATE_LIMIT_PER_MINUTE=30
